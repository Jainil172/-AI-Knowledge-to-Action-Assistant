// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Priority enum for tasks
enum Priority {
  HIGH
  MEDIUM
  LOW
}

// Severity enum for risks
enum Severity {
  HIGH
  MEDIUM
  LOW
}

// Document model - stores uploaded PDF information
model Document {
  id              String   @id @default(uuid())
  originalName    String
  storedFilename  String
  mimeType        String   @default("application/pdf")
  fileSize        Int
  pageCount       Int      @default(0)
  cleanedText     String?  @db.Text  // Preserved cleaned text for RAG processing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  tasks     Task[]
  risks     Risk[]
  decisions Decision[]
  chunks    DocumentChunk[]

  @@map("documents")
}

// Task model - extracted tasks from documents
model Task {
  id              String   @id @default(uuid())
  documentId      String
  title           String
  description     String?
  owner           String?
  deadline        String?  // Flexible type for dates and relative phrases
  priority        Priority?
  sourcePageNumber Int?
  sourceEvidence  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationship to Document
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("tasks")
}

// Risk model - extracted risks from documents
model Risk {
  id              String   @id @default(uuid())
  documentId      String
  title           String
  description     String?
  severity        Severity?
  sourcePageNumber Int?
  sourceEvidence  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationship to Document
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("risks")
}

// Decision model - extracted decisions from documents
model Decision {
  id              String   @id @default(uuid())
  documentId      String
  title           String
  description     String?
  sourcePageNumber Int?
  sourceEvidence  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationship to Document
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("decisions")
}

// DocumentChunk model - stores document chunks with embeddings for RAG
// Embeddings are stored as JSON arrays in a TEXT column for Prisma compatibility.
// When pgvector extension is available, migrate the embedding column to vector(384).
model DocumentChunk {
  id                  String   @id @default(uuid())
  documentId          String
  chunkIndex          Int
  text                String   @db.Text
  characterCount      Int
  embedding           String   @db.Text  // JSON array of floats, migrate to vector(384) with pgvector
  embeddingModel      String   @default("sentence-transformers/all-MiniLM-L6-v2")
  embeddingDimension  Int      @default(384)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relationship to Document
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Uniqueness constraint: one chunk index per document
  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}
